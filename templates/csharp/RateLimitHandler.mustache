using System;
using System.Collections.Concurrent;
using System.Threading;
using System.Threading.Tasks;

namespace {{packageName}}.Client
{
    /// <summary>
    /// Circuit breaker states for rate limit protection.
    /// </summary>
    public enum CircuitBreakerState
    {
        /// <summary>Circuit is closed, requests flow normally.</summary>
        Closed,
        /// <summary>Circuit is open, requests are rejected.</summary>
        Open,
        /// <summary>Circuit is half-open, one probe request is allowed.</summary>
        HalfOpen
    }

    /// <summary>
    /// Holds per-operation rate limit and circuit breaker state.
    /// </summary>
    public class OperationRateState
    {
        /// <summary>Gets or sets the operation key (e.g., "GET /orders/v0/orders").</summary>
        public string OperationKey { get; set; }

        /// <summary>Gets or sets the current rate in requests/second from the x-amzn-RateLimit-Limit header. Null if unknown.</summary>
        public double? CurrentRate { get; set; }

        /// <summary>Gets or sets the timestamp of the last request for rate spacing.</summary>
        public DateTime? LastRequestTime { get; set; }

        /// <summary>Gets or sets the circuit breaker state.</summary>
        public CircuitBreakerState CircuitState { get; set; } = CircuitBreakerState.Closed;

        /// <summary>Gets or sets the current cooldown duration in milliseconds.</summary>
        public double CooldownMs { get; set; }

        /// <summary>Gets or sets the time the circuit breaker was opened.</summary>
        public DateTime? OpenedAt { get; set; }

        /// <summary>Gets or sets whether a probe request is in progress (for half-open state).</summary>
        public int ProbeInProgress;
    }

    /// <summary>
    /// Provides rate limit protection with exponential backoff, dynamic rate tracking,
    /// and per-operation circuit breaker for the SP-API SDK.
    /// </summary>
    {{>visibility}} class RateLimitHandler
    {
        private const double BaseDelay = 1.0;
        private const double Multiplier = 2.0;
        private const int MaxRetries = 3;
        private const double MaxCooldownMs = 120000.0;
        private const double JitterMin = 0.0;
        private const double JitterMax = 0.25;
        private const string RateLimitHeaderName = "x-amzn-RateLimit-Limit";

        private readonly bool _enabled;
        private readonly ConcurrentDictionary<string, OperationRateState> _operationStates;
        private readonly Random _random;
        private readonly object _randomLock = new object();

        /// <summary>
        /// Gets whether rate limit protection is enabled.
        /// </summary>
        public bool RateLimitEnabled => _enabled;

        /// <summary>
        /// Initializes a new instance of the <see cref="RateLimitHandler"/> class.
        /// </summary>
        /// <param name="rateLimitEnabled">Whether rate limit protection is enabled (default true).</param>
        public RateLimitHandler(bool rateLimitEnabled = true)
        {
            _enabled = rateLimitEnabled;
            _operationStates = new ConcurrentDictionary<string, OperationRateState>();
            _random = new Random();
        }

        /// <summary>
        /// Executes a request with rate limit protection (synchronous).
        /// </summary>
        /// <param name="operationKey">The operation identifier (e.g., "GET /orders/v0/orders").</param>
        /// <param name="requestFn">The function that executes the HTTP request and returns a RestSharp RestResponse.</param>
        /// <returns>The response object.</returns>
        /// <exception cref="ApiException">Thrown when max retries exceeded or circuit is open.</exception>
        public RestSharp.RestResponse ExecuteWithProtection(string operationKey, Func<RestSharp.RestResponse> requestFn)
        {
            if (!_enabled)
            {
                return requestFn();
            }

            var state = _operationStates.GetOrAdd(operationKey, key => new OperationRateState { OperationKey = key });

            // Circuit breaker check
            CheckCircuitBreaker(operationKey, state);

            // Rate spacing
            ApplyRateSpacing(state);

            // Retry loop
            RestSharp.RestResponse lastResponse = null;
            for (int attempt = 0; attempt <= MaxRetries; attempt++)
            {
                lastResponse = requestFn();

                int statusCode = (int)lastResponse.StatusCode;

                // Success (2xx)
                if (statusCode >= 200 && statusCode < 300)
                {
                    ParseRateLimitHeader(state, lastResponse);
                    CloseCircuitBreaker(state);
                    return lastResponse;
                }

                // HTTP 429
                if (statusCode == 429)
                {
                    if (attempt < MaxRetries)
                    {
                        double delay = CalculateDelay(attempt + 1);
                        // Diagnostic: retry attempt number and delay
                        System.Diagnostics.Debug.WriteLine(
                            $"[RateLimitHandler] Retry attempt {attempt + 1}/{MaxRetries} for operation '{operationKey}', delay: {delay:F3}s");
                        Thread.Sleep((int)(delay * 1000));
                    }
                    else
                    {
                        // Max retries exceeded - open circuit breaker
                        double lastDelay = BaseDelay * Math.Pow(Multiplier, MaxRetries - 1);
                        OpenCircuitBreaker(state, lastDelay * 1000);

                        // Propagate original 429 error
                        throw new ApiException(
                            429,
                            $"Rate limit exceeded for operation '{operationKey}' after {MaxRetries + 1} attempts. Circuit breaker opened.",
                            lastResponse.Content);
                    }
                }
                else
                {
                    // Non-429 error or other status - pass through
                    return lastResponse;
                }
            }

            return lastResponse;
        }

        /// <summary>
        /// Executes a request with rate limit protection (asynchronous).
        /// </summary>
        /// <param name="operationKey">The operation identifier (e.g., "GET /orders/v0/orders").</param>
        /// <param name="requestFn">The async function that executes the HTTP request.</param>
        /// <returns>The response object.</returns>
        /// <exception cref="ApiException">Thrown when max retries exceeded or circuit is open.</exception>
        public async Task<RestSharp.RestResponse> ExecuteWithProtectionAsync(string operationKey, Func<Task<RestSharp.RestResponse>> requestFn)
        {
            if (!_enabled)
            {
                return await requestFn().ConfigureAwait(false);
            }

            var state = _operationStates.GetOrAdd(operationKey, key => new OperationRateState { OperationKey = key });

            // Circuit breaker check
            CheckCircuitBreaker(operationKey, state);

            // Rate spacing (async)
            await ApplyRateSpacingAsync(state).ConfigureAwait(false);

            // Retry loop
            RestSharp.RestResponse lastResponse = null;
            for (int attempt = 0; attempt <= MaxRetries; attempt++)
            {
                lastResponse = await requestFn().ConfigureAwait(false);

                int statusCode = (int)lastResponse.StatusCode;

                // Success (2xx)
                if (statusCode >= 200 && statusCode < 300)
                {
                    ParseRateLimitHeader(state, lastResponse);
                    CloseCircuitBreaker(state);
                    return lastResponse;
                }

                // HTTP 429
                if (statusCode == 429)
                {
                    if (attempt < MaxRetries)
                    {
                        double delay = CalculateDelay(attempt + 1);
                        // Diagnostic: retry attempt number and delay
                        System.Diagnostics.Debug.WriteLine(
                            $"[RateLimitHandler] Retry attempt {attempt + 1}/{MaxRetries} for operation '{operationKey}', delay: {delay:F3}s");
                        await Task.Delay((int)(delay * 1000)).ConfigureAwait(false);
                    }
                    else
                    {
                        // Max retries exceeded - open circuit breaker
                        double lastDelay = BaseDelay * Math.Pow(Multiplier, MaxRetries - 1);
                        OpenCircuitBreaker(state, lastDelay * 1000);

                        // Propagate original 429 error
                        throw new ApiException(
                            429,
                            $"Rate limit exceeded for operation '{operationKey}' after {MaxRetries + 1} attempts. Circuit breaker opened.",
                            lastResponse.Content);
                    }
                }
                else
                {
                    // Non-429 error or other status - pass through
                    return lastResponse;
                }
            }

            return lastResponse;
        }

        /// <summary>
        /// Calculates the exponential backoff delay with jitter.
        /// </summary>
        /// <param name="attemptNumber">The retry attempt number (1-based).</param>
        /// <returns>The delay in seconds including jitter.</returns>
        private double CalculateDelay(int attemptNumber)
        {
            double baseCalculatedDelay = BaseDelay * Math.Pow(Multiplier, attemptNumber - 1);
            double jitterFraction;
            lock (_randomLock)
            {
                jitterFraction = JitterMin + (_random.NextDouble() * (JitterMax - JitterMin));
            }
            return baseCalculatedDelay * (1.0 + jitterFraction);
        }

        /// <summary>
        /// Checks the circuit breaker state for an operation and throws if the circuit is open.
        /// </summary>
        private void CheckCircuitBreaker(string operationKey, OperationRateState state)
        {
            lock (state)
            {
                switch (state.CircuitState)
                {
                    case CircuitBreakerState.Open:
                        if (state.OpenedAt.HasValue)
                        {
                            double elapsedMs = (DateTime.UtcNow - state.OpenedAt.Value).TotalMilliseconds;
                            if (elapsedMs >= state.CooldownMs)
                            {
                                // Transition to half-open
                                var previousState = state.CircuitState;
                                state.CircuitState = CircuitBreakerState.HalfOpen;
                                Interlocked.Exchange(ref state.ProbeInProgress, 0);
                                System.Diagnostics.Debug.WriteLine(
                                    $"[RateLimitHandler] Circuit breaker state transition for '{operationKey}': {previousState} -> {state.CircuitState}");
                            }
                            else
                            {
                                double remainingMs = state.CooldownMs - elapsedMs;
                                throw new ApiException(
                                    429,
                                    $"Circuit breaker is open for operation '{operationKey}'. Remaining cooldown: {remainingMs:F0}ms.");
                            }
                        }
                        break;

                    case CircuitBreakerState.HalfOpen:
                        // Only allow one probe request
                        if (Interlocked.CompareExchange(ref state.ProbeInProgress, 1, 0) != 0)
                        {
                            double remainingMs = 0;
                            if (state.OpenedAt.HasValue)
                            {
                                remainingMs = Math.Max(0, state.CooldownMs - (DateTime.UtcNow - state.OpenedAt.Value).TotalMilliseconds);
                            }
                            throw new ApiException(
                                429,
                                $"Circuit breaker is half-open for operation '{operationKey}'. Probe in progress, rejecting additional requests. Remaining cooldown: {remainingMs:F0}ms.");
                        }
                        break;

                    case CircuitBreakerState.Closed:
                        // Allow request
                        break;
                }
            }
        }

        /// <summary>
        /// Applies rate spacing to enforce 1/rate seconds between requests per operation (synchronous).
        /// </summary>
        private void ApplyRateSpacing(OperationRateState state)
        {
            lock (state)
            {
                if (state.CurrentRate.HasValue && state.CurrentRate.Value > 0 && state.LastRequestTime.HasValue)
                {
                    double intervalMs = (1.0 / state.CurrentRate.Value) * 1000.0;
                    double elapsedMs = (DateTime.UtcNow - state.LastRequestTime.Value).TotalMilliseconds;
                    double waitMs = intervalMs - elapsedMs;

                    if (waitMs > 0)
                    {
                        // Release the lock while sleeping to avoid blocking other operations
                        Monitor.Exit(state);
                        try
                        {
                            Thread.Sleep((int)Math.Ceiling(waitMs));
                        }
                        finally
                        {
                            Monitor.Enter(state);
                        }
                    }
                }
                state.LastRequestTime = DateTime.UtcNow;
            }
        }

        /// <summary>
        /// Applies rate spacing to enforce 1/rate seconds between requests per operation (asynchronous).
        /// </summary>
        private async Task ApplyRateSpacingAsync(OperationRateState state)
        {
            double waitMs = 0;
            lock (state)
            {
                if (state.CurrentRate.HasValue && state.CurrentRate.Value > 0 && state.LastRequestTime.HasValue)
                {
                    double intervalMs = (1.0 / state.CurrentRate.Value) * 1000.0;
                    double elapsedMs = (DateTime.UtcNow - state.LastRequestTime.Value).TotalMilliseconds;
                    waitMs = intervalMs - elapsedMs;
                }
            }

            if (waitMs > 0)
            {
                await Task.Delay((int)Math.Ceiling(waitMs)).ConfigureAwait(false);
            }

            lock (state)
            {
                state.LastRequestTime = DateTime.UtcNow;
            }
        }

        /// <summary>
        /// Parses the x-amzn-RateLimit-Limit header from a 2xx response and updates the stored rate.
        /// Discards non-numeric, zero, or negative values.
        /// </summary>
        private void ParseRateLimitHeader(OperationRateState state, RestSharp.RestResponse response)
        {
            if (response.Headers == null)
                return;

            foreach (var header in response.Headers)
            {
                if (string.Equals(header.Name, RateLimitHeaderName, StringComparison.OrdinalIgnoreCase))
                {
                    string headerValue = header.Value?.ToString();
                    if (!string.IsNullOrEmpty(headerValue) && double.TryParse(headerValue, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double rate))
                    {
                        if (rate > 0)
                        {
                            lock (state)
                            {
                                state.CurrentRate = rate;
                            }
                            System.Diagnostics.Debug.WriteLine(
                                $"[RateLimitHandler] Rate updated for '{state.OperationKey}': {rate} requests/second");
                        }
                        // else: zero or negative - discard, retain previous rate
                    }
                    // else: non-numeric - discard, retain previous rate
                    break;
                }
            }
        }

        /// <summary>
        /// Closes the circuit breaker for an operation (transitions to Closed state).
        /// </summary>
        private void CloseCircuitBreaker(OperationRateState state)
        {
            lock (state)
            {
                if (state.CircuitState != CircuitBreakerState.Closed)
                {
                    var previousState = state.CircuitState;
                    state.CircuitState = CircuitBreakerState.Closed;
                    state.OpenedAt = null;
                    Interlocked.Exchange(ref state.ProbeInProgress, 0);
                    System.Diagnostics.Debug.WriteLine(
                        $"[RateLimitHandler] Circuit breaker state transition for '{state.OperationKey}': {previousState} -> Closed");
                }
            }
        }

        /// <summary>
        /// Opens the circuit breaker for an operation with the specified cooldown.
        /// </summary>
        /// <param name="state">The operation rate state.</param>
        /// <param name="cooldownMs">The cooldown duration in milliseconds.</param>
        private void OpenCircuitBreaker(OperationRateState state, double cooldownMs)
        {
            lock (state)
            {
                var previousState = state.CircuitState;

                // If transitioning from half-open back to open, double the cooldown
                if (state.CircuitState == CircuitBreakerState.HalfOpen)
                {
                    cooldownMs = Math.Min(state.CooldownMs * 2, MaxCooldownMs);
                }
                else
                {
                    cooldownMs = Math.Min(cooldownMs, MaxCooldownMs);
                }

                state.CircuitState = CircuitBreakerState.Open;
                state.CooldownMs = cooldownMs;
                state.OpenedAt = DateTime.UtcNow;
                Interlocked.Exchange(ref state.ProbeInProgress, 0);

                System.Diagnostics.Debug.WriteLine(
                    $"[RateLimitHandler] Circuit breaker state transition for '{state.OperationKey}': {previousState} -> Open (cooldown: {cooldownMs:F0}ms)");
            }
        }

        /// <summary>
        /// Handles circuit breaker state update after a probe request completes.
        /// Called when the response is received for a half-open probe.
        /// </summary>
        /// <param name="state">The operation rate state.</param>
        /// <param name="statusCode">The HTTP status code of the probe response.</param>
        /// <param name="isNetworkError">Whether the probe failed due to a network error.</param>
        internal void HandleProbeResult(OperationRateState state, int statusCode, bool isNetworkError)
        {
            lock (state)
            {
                if (state.CircuitState != CircuitBreakerState.HalfOpen)
                    return;

                if (isNetworkError)
                {
                    // Network error - reopen with same cooldown (no doubling)
                    var previousState = state.CircuitState;
                    state.CircuitState = CircuitBreakerState.Open;
                    state.OpenedAt = DateTime.UtcNow;
                    // CooldownMs stays the same
                    Interlocked.Exchange(ref state.ProbeInProgress, 0);
                    System.Diagnostics.Debug.WriteLine(
                        $"[RateLimitHandler] Circuit breaker state transition for '{state.OperationKey}': {previousState} -> Open (network error, same cooldown: {state.CooldownMs:F0}ms)");
                }
                else if (statusCode == 429)
                {
                    // 429 on probe - reopen with doubled cooldown
                    var previousState = state.CircuitState;
                    state.CooldownMs = Math.Min(state.CooldownMs * 2, MaxCooldownMs);
                    state.CircuitState = CircuitBreakerState.Open;
                    state.OpenedAt = DateTime.UtcNow;
                    Interlocked.Exchange(ref state.ProbeInProgress, 0);
                    System.Diagnostics.Debug.WriteLine(
                        $"[RateLimitHandler] Circuit breaker state transition for '{state.OperationKey}': {previousState} -> Open (429 on probe, doubled cooldown: {state.CooldownMs:F0}ms)");
                }
                else
                {
                    // Non-429 response - close circuit
                    var previousState = state.CircuitState;
                    state.CircuitState = CircuitBreakerState.Closed;
                    state.OpenedAt = null;
                    Interlocked.Exchange(ref state.ProbeInProgress, 0);
                    System.Diagnostics.Debug.WriteLine(
                        $"[RateLimitHandler] Circuit breaker state transition for '{state.OperationKey}': {previousState} -> Closed (probe succeeded)");
                }
            }
        }

        /// <summary>
        /// Builder class for creating RateLimitHandler instances.
        /// </summary>
        public class Builder
        {
            private bool _rateLimitEnabled = true;

            /// <summary>
            /// Sets whether rate limit protection is enabled.
            /// </summary>
            /// <param name="enabled">True to enable rate limit protection (default), false to disable.</param>
            /// <returns>This builder instance for chaining.</returns>
            public Builder WithRateLimitEnabled(bool enabled)
            {
                _rateLimitEnabled = enabled;
                return this;
            }

            /// <summary>
            /// Builds the RateLimitHandler instance.
            /// </summary>
            /// <returns>A new RateLimitHandler instance.</returns>
            public RateLimitHandler Build()
            {
                return new RateLimitHandler(_rateLimitEnabled);
            }
        }
    }
}
