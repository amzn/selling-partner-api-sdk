/**
 * Converts one of the generator's HTTP Observables into a Promise.
 *
 * The generic "typescript" generator emits either RxJS Observables (when
 * generated with useRxJS) or a minimal Promise-backed stub. This helper hides
 * that difference so the rate limiter can operate purely on Promises.
 */
function responseToPromise(source: Observable<ResponseContext>): Promise<ResponseContext> {
{{#useRxJS}}
    return firstValueFrom(source);
{{/useRxJS}}
{{^useRxJS}}
    return source.toPromise() as Promise<ResponseContext>;
{{/useRxJS}}
}

/**
 * An {@link HttpLibrary} decorator that routes every request through a
 * {@link RateLimiter}, providing automatic HTTP 429 handling (exponential
 * backoff retry, dynamic rate spacing and a per-operation circuit breaker)
 * transparently for all generated APIs.
 *
 * This is installed automatically by {@link createConfiguration} unless
 * rate limit protection is disabled.
 */
export class RateLimitedHttpLibrary implements HttpLibrary {
    private readonly delegate: HttpLibrary;
    private readonly rateLimiter: RateLimiter;

    /**
     * @param delegate The underlying HTTP library that performs the actual request.
     * @param rateLimiter The rate limiter to apply. Defaults to an enabled limiter.
     */
    constructor(delegate: HttpLibrary, rateLimiter: RateLimiter = new RateLimiter()) {
        this.delegate = delegate;
        this.rateLimiter = rateLimiter;
    }

    send(request: RequestContext): Observable<ResponseContext> {
        // If protection is disabled, pass straight through untouched.
        if (!this.rateLimiter.enabled) {
            return this.delegate.send(request);
        }

        const operationKey = this.buildOperationKey(request);
        const execute = (): Promise<ResponseContext> =>
            responseToPromise(this.delegate.send(request));

        return from(this.rateLimiter.executeWithProtection(operationKey, execute));
    }

    /**
     * Derives a stable operation key ("METHOD /path") used to scope rate state
     * and the circuit breaker per operation.
     */
    private buildOperationKey(request: RequestContext): string {
        const method = request.getHttpMethod().toString().toUpperCase();
        let path = request.getUrl();
        try {
            path = new URL(request.getUrl()).pathname;
        } catch {
            // getUrl() should always be absolute here, but fall back gracefully.
        }
        return `${method} ${path}`;
    }
}
