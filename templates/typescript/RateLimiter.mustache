/**
 * Rate Limit Protection for the SP-API TypeScript SDK.
 *
 * Provides automatic rate limit handling including:
 * - Exponential backoff retry on HTTP 429 responses
 * - Dynamic rate tracking via the x-amzn-RateLimit-Limit header
 * - Per-operation circuit breaker
 */

/**
 * Circuit breaker states.
 */
export enum CircuitBreakerState {
    CLOSED = 'CLOSED',
    OPEN = 'OPEN',
    HALF_OPEN = 'HALF_OPEN',
}

/**
 * Options accepted by the RateLimiter constructor.
 */
export interface RateLimiterOptions {
    rateLimitEnabled?: boolean;
}

interface CircuitBreaker {
    state: CircuitBreakerState;
    cooldownMs: number;
    openedAt: number | null;
    probeInProgress: boolean;
}

interface OperationRateState {
    operationKey: string;
    currentRate: number | null;
    lastRequestTime: number | null;
    circuitBreaker: CircuitBreaker;
}

/**
 * A minimal, HTTP-library-agnostic view of a response that the rate limiter inspects.
 */
export interface RateLimitedResponse {
    status?: number;
    statusCode?: number;
    // The generic openapi-generator "typescript" ResponseContext exposes the
    // HTTP status under `httpStatusCode`.
    httpStatusCode?: number;
    headers?: Record<string, string | string[] | undefined> | null;
    header?: Record<string, string | string[] | undefined> | null;
    body?: unknown;
    text?: unknown;
}

/**
 * Error raised/annotated by the rate limiter.
 */
export interface RateLimitError extends Error {
    isRateLimitError?: boolean;
    isCircuitBreakerError?: boolean;
    status?: number;
    statusCode?: number;
    headers?: unknown;
    body?: unknown;
    operationKey?: string;
    totalAttempts?: number;
    retryAttempt?: number;
    retryDelay?: number;
    circuitState?: CircuitBreakerState;
    remainingCooldownMs?: number;
    response?: unknown;
}

/**
 * Manages rate limit protection for SP-API operations.
 *
 * Wraps request execution with exponential backoff retry, dynamic rate spacing
 * based on the x-amzn-RateLimit-Limit response header, and a per-operation
 * circuit breaker that blocks requests to throttled operations during cooldown.
 */
export class RateLimiter {
    private readonly enabledFlag: boolean;
    private readonly maxRetries: number;
    private readonly baseDelay: number;
    private readonly maxCooldown: number;
    private readonly operationStates: Map<string, OperationRateState>;

    constructor(options: RateLimiterOptions = {}) {
        this.enabledFlag = options.rateLimitEnabled !== undefined ? options.rateLimitEnabled : true;
        this.maxRetries = 3;
        this.baseDelay = 1.0;
        this.maxCooldown = 120.0;
        this.operationStates = new Map<string, OperationRateState>();
    }

    /**
     * Returns whether rate limit protection is enabled.
     */
    get enabled(): boolean {
        return this.enabledFlag;
    }

    private getOperationState(operationKey: string): OperationRateState {
        let state = this.operationStates.get(operationKey);
        if (!state) {
            state = {
                operationKey,
                currentRate: null,
                lastRequestTime: null,
                circuitBreaker: {
                    state: CircuitBreakerState.CLOSED,
                    cooldownMs: 0,
                    openedAt: null,
                    probeInProgress: false,
                },
            };
            this.operationStates.set(operationKey, state);
        }
        return state;
    }

    /**
     * Executes a request with rate limit protection.
     *
     * When enabled, applies circuit breaker checks, rate spacing, exponential
     * backoff retry on 429, and rate header parsing on success.
     *
     * @param operationKey The operation identifier (e.g., "GET /orders/v0/orders").
     * @param requestFn An async function that executes the HTTP request and returns a response object.
     */
    async executeWithProtection<T extends RateLimitedResponse>(
        operationKey: string,
        requestFn: () => Promise<T>
    ): Promise<T> {
        if (!this.enabledFlag) {
            return requestFn();
        }

        const opState = this.getOperationState(operationKey);

        this.checkCircuitBreaker(opState);
        await this.applyRateSpacing(opState);

        let lastError: RateLimitError | null = null;

        for (let attempt = 0; attempt <= this.maxRetries; attempt++) {
            try {
                const response = await requestFn();
                const statusCode = this.getStatusCode(response);

                if (statusCode >= 200 && statusCode < 300) {
                    this.parseRateLimitHeader(opState, response);
                    this.closeCircuitBreaker(opState);
                    return response;
                }

                if (statusCode === 429) {
                    lastError = this.create429Error(response, operationKey, attempt + 1);

                    if (attempt < this.maxRetries) {
                        const delay = this.calculateDelay(attempt);
                        const jitter = Math.random() * 0.25 * delay;
                        const totalDelay = delay + jitter;

                        lastError.retryAttempt = attempt + 1;
                        lastError.retryDelay = totalDelay;

                        await this.sleep(totalDelay * 1000);
                    } else {
                        const lastDelay = this.calculateDelay(attempt - 1);
                        this.openCircuitBreaker(opState, lastDelay * 1000);

                        const error = this.create429Error(response, operationKey, attempt + 1);
                        error.totalAttempts = attempt + 1;
                        error.operationKey = operationKey;
                        throw error;
                    }
                } else {
                    // Non-429 error - pass through without retry
                    return response;
                }
            } catch (err) {
                const error = err as RateLimitError;
                if (error.isRateLimitError || error.isCircuitBreakerError) {
                    throw error;
                }
                if (opState.circuitBreaker.state === CircuitBreakerState.HALF_OPEN) {
                    this.reopenCircuitBreakerSameCooldown(opState);
                    throw error;
                }
                throw error;
            }
        }

        throw lastError as RateLimitError;
    }

    private checkCircuitBreaker(opState: OperationRateState): void {
        const cb = opState.circuitBreaker;

        if (cb.state === CircuitBreakerState.CLOSED) {
            return;
        }

        if (cb.state === CircuitBreakerState.OPEN) {
            const elapsed = Date.now() - (cb.openedAt ?? 0);
            if (elapsed >= cb.cooldownMs) {
                const previousState = cb.state;
                cb.state = CircuitBreakerState.HALF_OPEN;
                cb.probeInProgress = false;
                this.logStateTransition(opState.operationKey, previousState, cb.state);
            } else {
                const remainingMs = cb.cooldownMs - elapsed;
                const error: RateLimitError = new Error(
                    `Circuit breaker is OPEN for operation "${opState.operationKey}". ` +
                    `Remaining cooldown: ${Math.ceil(remainingMs)}ms`
                );
                error.isCircuitBreakerError = true;
                error.operationKey = opState.operationKey;
                error.circuitState = CircuitBreakerState.OPEN;
                error.remainingCooldownMs = Math.ceil(remainingMs);
                throw error;
            }
        }

        if (cb.state === CircuitBreakerState.HALF_OPEN) {
            if (cb.probeInProgress) {
                const error: RateLimitError = new Error(
                    `Circuit breaker is HALF_OPEN for operation "${opState.operationKey}". ` +
                    `Probe request in progress, rejecting additional requests.`
                );
                error.isCircuitBreakerError = true;
                error.operationKey = opState.operationKey;
                error.circuitState = CircuitBreakerState.HALF_OPEN;
                error.remainingCooldownMs = 0;
                throw error;
            }
            cb.probeInProgress = true;
        }
    }

    private async applyRateSpacing(opState: OperationRateState): Promise<void> {
        if (opState.currentRate === null || opState.lastRequestTime === null) {
            opState.lastRequestTime = Date.now();
            return;
        }

        const minInterval = (1.0 / opState.currentRate) * 1000;
        const elapsed = Date.now() - opState.lastRequestTime;
        const waitTime = minInterval - elapsed;

        if (waitTime > 0) {
            await this.sleep(waitTime);
        }

        opState.lastRequestTime = Date.now();
    }

    private parseRateLimitHeader(opState: OperationRateState, response: RateLimitedResponse): void {
        const headers = this.getHeaders(response);
        if (!headers) {
            return;
        }

        const headerValue =
            headers['x-amzn-ratelimit-limit'] ??
            headers['x-amzn-RateLimit-Limit'] ??
            headers['X-Amzn-RateLimit-Limit'];

        if (headerValue === undefined || headerValue === null) {
            return;
        }

        const rate = parseFloat(Array.isArray(headerValue) ? headerValue[0] : headerValue);

        if (isNaN(rate) || rate <= 0) {
            return;
        }

        opState.currentRate = rate;
    }

    private closeCircuitBreaker(opState: OperationRateState): void {
        const cb = opState.circuitBreaker;
        if (cb.state !== CircuitBreakerState.CLOSED) {
            const previousState = cb.state;
            cb.state = CircuitBreakerState.CLOSED;
            cb.cooldownMs = 0;
            cb.openedAt = null;
            cb.probeInProgress = false;
            this.logStateTransition(opState.operationKey, previousState, cb.state);
        }
    }

    private openCircuitBreaker(opState: OperationRateState, cooldownMs: number): void {
        const cb = opState.circuitBreaker;
        const previousState = cb.state;

        if (previousState === CircuitBreakerState.HALF_OPEN) {
            cooldownMs = Math.min(cb.cooldownMs * 2, this.maxCooldown * 1000);
        }

        cb.state = CircuitBreakerState.OPEN;
        cb.cooldownMs = Math.min(cooldownMs, this.maxCooldown * 1000);
        cb.openedAt = Date.now();
        cb.probeInProgress = false;
        this.logStateTransition(opState.operationKey, previousState, cb.state);
    }

    private reopenCircuitBreakerSameCooldown(opState: OperationRateState): void {
        const cb = opState.circuitBreaker;
        const previousState = cb.state;
        cb.state = CircuitBreakerState.OPEN;
        cb.openedAt = Date.now();
        cb.probeInProgress = false;
        this.logStateTransition(opState.operationKey, previousState, cb.state);
    }

    private calculateDelay(attempt: number): number {
        return this.baseDelay * Math.pow(2, attempt);
    }

    private create429Error(
        response: RateLimitedResponse,
        operationKey: string,
        attemptNumber: number
    ): RateLimitError {
        const statusCode = this.getStatusCode(response);
        const headers = this.getHeaders(response);
        const body = this.getBody(response);

        const error: RateLimitError = new Error(
            `Rate limit exceeded for operation "${operationKey}" ` +
            `after ${attemptNumber} attempt(s). HTTP 429 Too Many Requests.`
        );
        error.isRateLimitError = true;
        error.status = statusCode;
        error.statusCode = statusCode;
        error.headers = headers;
        error.body = body;
        error.operationKey = operationKey;
        error.totalAttempts = attemptNumber;
        return error;
    }

    private getStatusCode(response: RateLimitedResponse): number {
        if (response && response.httpStatusCode !== undefined) {
            return response.httpStatusCode;
        }
        if (response && response.status !== undefined) {
            return response.status;
        }
        if (response && response.statusCode !== undefined) {
            return response.statusCode;
        }
        return 0;
    }

    private getHeaders(
        response: RateLimitedResponse
    ): Record<string, string | string[] | undefined> | null {
        if (response && response.headers) {
            return response.headers;
        }
        if (response && response.header) {
            return response.header;
        }
        return null;
    }

    private getBody(response: RateLimitedResponse): unknown {
        if (response && response.body !== undefined) {
            return response.body;
        }
        if (response && response.text !== undefined) {
            return response.text;
        }
        return null;
    }

    private logStateTransition(
        operationKey: string,
        previousState: CircuitBreakerState,
        newState: CircuitBreakerState
    ): void {
        if (typeof console !== 'undefined' && console.debug) {
            console.debug(
                `[RateLimiter] Circuit breaker transition for "${operationKey}": ${previousState} -> ${newState}`
            );
        }
    }

    private sleep(ms: number): Promise<void> {
        return new Promise((resolve) => setTimeout(resolve, ms));
    }
}

