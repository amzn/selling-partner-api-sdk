/**
 * Asserts a response payload is present unless the response is 204 No Content.
 */
function assertValidResponsePayload(statusCode: number, payload: unknown): void {
    if (statusCode !== 204) {
        expect(payload).to.be.ok();
    }
}

/**
 * Instructs the mock backend which canned response to return for the next call.
 *
 * Mirrors the JavaScript SDK: the mock serves `res/responses/<name>Response.json`
 * where `<name>` is `<compressedTag>-<operationId>`, with the given status code.
 */
async function instructBackendMock(tag: string, operationId: string, code: string): Promise<void> {
    const compressedTag = tag.replace(/[\W\s]/g, '').toLowerCase();
    const url = `${endpoint}/response/${compressedTag}-${operationId}/code/${code}`;
    try {
        await fetch(url, { method: 'POST', body: null });
    } catch (error) {
        console.error('Request to configure mock backend failed:', error);
    }
}

/**
 * Generates random mock data for a required parameter based on its type.
 *
 * Primitive types get representative random values; everything else (model
 * types) gets an empty object, which is sufficient because the mock backend
 * ignores request bodies and returns the pre-configured canned response.
 */
function generateMockData(dataType: string, isArray = false): unknown {
    if (!dataType) {
        return {};
    }

    if (isArray) {
        return [generateMockData(dataType), generateMockData(dataType)];
    }

    switch (dataType) {
        case 'string':
            return 'mock-' + Math.random().toString(36).substring(2, 10);
        case 'number':
            return Math.floor(Math.random() * 1000);
        case 'boolean':
            return Math.random() > 0.5;
        case 'Date':
            return new Date();
        default:
            return {};
    }
}
