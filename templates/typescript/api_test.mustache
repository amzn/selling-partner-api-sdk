import type { RequestContext } from '../http/http';

const endpoint = 'http://localhost:3000';

/**
 * Test access token authentication.
 *
 * The generated APIs do not declare an SP-API security scheme to the code
 * generator, so we attach the `x-amz-access-token` header via a custom
 * authentication method rather than through generated auth config.
 */
const testAuth = {
    getName(): string {
        return 'testAccessToken';
    },
    applySecurityAuthentication(context: RequestContext): void {
        context.setHeaderParam('x-amz-access-token', 'testAccessToken');
    },
};

/**
 * Builds a Configuration pointed at the local mock backend with the test
 * access token applied to every request.
 */
function buildConfiguration() {
    return createConfiguration({
        baseServer: new ServerConfiguration(endpoint, {}),
        authMethods: { default: testAuth },
    });
}

