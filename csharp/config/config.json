{
    "packageName": "software.amzn.spapi",
    "packageVersion": "0.0.0",
    "targetFramework": "net7.0",
    "engineOptions": { "library": "Stubble" },
    "globalProperties": {
        "modelTests": false,
        "modelDocs": false,
        "apiDocs": false
    },
    "files": {
        "RateLimitHandler.mustache": {
            "templateFile": "RateLimitHandler.mustache",
            "destinationFilename": "src/software.amzn.spapi/Client/RateLimitHandler.cs"
        },
        "rate_limit_test.mustache": {
            "templateFile": "rate_limit_test.mustache",
            "destinationFilename": "src/software.amzn.spapi.Test/Client/RateLimitProtectionTests.cs"
        }
    }
}